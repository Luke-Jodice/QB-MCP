# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Your Quickbase user token (Settings → My Preferences → Manage User Tokens)
QB_USER_TOKEN=your_user_token_here

# Your Quickbase realm hostname (e.g. mycompany.quickbase.com)
QB_REALM_HOSTNAME=your_realm.quickbase.com
